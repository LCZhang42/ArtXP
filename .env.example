# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional Playwright override:
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173

# Backend development settings
ARTXP_ENVIRONMENT=development
ARTXP_FRONTEND_URL=http://localhost:5173
ARTXP_SESSION_SECRET=change-me-before-sharing-an-environment
ARTXP_SESSION_COOKIE_SECURE=false
ARTXP_DATABASE_URL=postgresql+psycopg://artxp:artxp@localhost:5432/artxp
ARTXP_REDIS_URL=redis://localhost:6379/0
ARTXP_S3_ENDPOINT_URL=http://localhost:9000
ARTXP_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
ARTXP_S3_ACCESS_KEY=artxp
ARTXP_S3_SECRET_KEY=artxp-development-only
ARTXP_S3_BUCKET=artxp-artworks
ARTXP_S3_REGION=us-east-1
ARTXP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ARTXP_INFRASTRUCTURE_REQUIRED=true
ARTXP_AUTO_CREATE_SCHEMA=false

# Production OIDC (leave unset for local development)
# ARTXP_OIDC_ISSUER_URL=https://identity.example.com
# ARTXP_OIDC_CLIENT_ID=replace-me
# ARTXP_OIDC_CLIENT_SECRET=replace-me
# ARTXP_OIDC_REDIRECT_URI=https://api.example.com/api/v1/auth/callback