# Phase 0 runs entirely in the browser and requires no environment variables.
# API keys are currently entered by the user in Settings and stored locally.
# Phase 2 will remove that legacy behavior and route model calls through FastAPI.

# Reserved for the Phase 1 backend integration:
# VITE_API_BASE_URL=http://localhost:8000

# Optional override used by the Playwright configuration:
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
